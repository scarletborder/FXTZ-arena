{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for the FXTZ Arena desktop client.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "process:default",
    "updater:default",
    "fs:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://scarletborder.github.io/**" },
        { "url": "https://gh-proxy.org/**" }
      ]
    }
  ]
}