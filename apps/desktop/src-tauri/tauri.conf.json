{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FXTZ Arena",
  "version": "0.0.0",
  "identifier": "com.fxtz.arena.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter frontend dev:desktop",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FXTZ Arena",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --ignore-certificate-errors --allow-insecure-localhost"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://asset.localhost https://scarletborder.github.io https://gh-proxy.org", 
      "assetProtocol": {
        "enable": true,
        "scope": [ "**/*" ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [ "icons/icon.ico" ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENTFBQUIyNzA1ODZEMzkKUldRNWJWaHdzcXBSemZzS3AyOHJPUXhEcmtSc21GcFBhSHdpYmJTNHF3VDJvUGlpcW14OGFhbzAK",
      "endpoints": [
        "https://gh-proxy.org/https://github.com/scarletborder/FXTZ-arena/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
