{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build:resources": "node ../../scripts/build-resources.mjs",
    "build": "pnpm build:resources && vite build",
    "build:browser": "pnpm build:resources && vite build",
    "build:desktop": "pnpm build:resources && cross-env VITE_APP_TARGET=desktop vite build",
    "dev": "pnpm build:resources && vite --host 0.0.0.0 --port 3000 --clearScreen false",
    "dev:desktop": "pnpm build:resources && cross-env VITE_APP_TARGET=desktop vite --host 0.0.0.0 --port 3000 --clearScreen false",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/constants": "workspace:*",
    "@repo/content": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/raid-logic": "workspace:*",
    "@repo/types": "workspace:*",
    "@shaisrc/fixed-point": "^0.1.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@zakkster/lite-rollback": "^1.0.2",
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
