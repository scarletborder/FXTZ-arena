{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FXTZ Arena",
  "version": "0.0.0",
  "identifier": "com.fxtz.arena.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FXTZ Arena",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --ignore-certificate-errors --allow-insecure-localhost"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
