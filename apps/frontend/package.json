{
  "name": "frontend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:browser": "vite build",
    "build:desktop": "cross-env VITE_APP_TARGET=desktop vite build",
    "dev": "vite --host 0.0.0.0 --port 3000 --clearScreen false",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/constants": "workspace:*",
    "@repo/content": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/raid-logic": "workspace:*",
    "@repo/types": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@shaisrc/fixed-point": "^0.1.0",
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "cross-env": "^7.0.3",
    "typescript": "5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
